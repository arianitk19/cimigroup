{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!assets/|css/|js/|manifest.json|service-worker.js|offline.html|favicon.*|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/service-worker.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
